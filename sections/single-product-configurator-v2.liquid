{%- liquid
  assign p = product
  assign uid = section.id
  assign cv = p.selected_or_first_available_variant
-%}
{% if p == blank %}<section class="p-8 text-center">Product not found.</section>{% else %}
{% capture variants_json %}[{% for v in p.variants %}{"id":{{v.id}},"available":{{v.available|json}},"price":{{v.price}},"option1":{{v.option1|json}},"option2":{{v.option2|json}},"option3":{{v.option3|json}},"image":{% if v.featured_image %}{{v.featured_image|image_url:width:1200|json}}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]{% endcapture %}
{% capture plans_json %}[{% assign pc=0 %}{% for group in p.selling_plan_groups %}{% for plan in group.selling_plans %}{% unless pc==0 %},{% endunless %}{"id":{{plan.id}},"name":{{plan.name|json}},"adjustments":{{plan.price_adjustments|json}}}{% assign pc=pc|plus:1 %}{% endfor %}{% endfor %}]{% endcapture %}
<section id="pcv2-{{uid}}" class="pcv2" x-data='{
 variants:{{variants_json|strip_newlines}},plans:{{plans_json|strip_newlines}},selected:{{cv.options|json}},img:{% if cv.featured_image %}{{cv.featured_image|image_url:width:1200|json}}{% elsif p.featured_media %}{{p.featured_media|image_url:width:1200|json}}{% else %}""{% endif %},mode:"subscription",planId:"",
 get variant(){return this.variants.find(v=>(v.option1??null)===(this.selected[0]??null)&&(v.option2??null)===(this.selected[1]??null)&&(v.option3??null)===(this.selected[2]??null))||this.variants.find(v=>v.available)||this.variants[0]},get plan(){return this.plans.find(x=>String(x.id)===String(this.planId))||null},money(c){return (Number(c||0)/100).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})+" {{cart.currency.symbol}}"},get price(){let n=this.variant?.price||0;if(this.mode==="subscription"&&this.plan&&(this.plan.adjustments||[]).length){let a=this.plan.adjustments[0];if(a.value_type==="percentage")n=n*(100-Number(a.value))/100;else if(a.value_type==="fixed_amount")n-=Number(a.value);else if(a.value_type==="price")n=Number(a.value)}return Math.max(0,Math.round(n))},pick(i,v){this.selected=this.selected.slice();this.selected[i]=v;if(this.variant?.image)this.img=this.variant.image},available(i,v){let s=this.selected.slice();s[i]=v;return this.variants.some(x=>x.available&&(i===0||x.option1===s[0])&&(i===1||x.option2===s[1])&&(i===2||x.option3===s[2])&&x["option"+(i+1)]===v)},init(){if(this.plans.length)this.planId=String(this.plans[0].id);else this.mode="one-time"}}'>
<div class="pcv2-grid"><div class="pcv2-gallery"><aside class="pcv2-thumbs">{% for m in p.media %}{% if m.media_type=='image' %}<button type="button" :class="img==={{m|image_url:width:1200|json}}?'active':''" @click="img={{m|image_url:width:1200|json}}">{{m|image_url:width:160|image_tag:class:'pcv2-thumb-img',alt:p.title}}</button>{% endif %}{% endfor %}</aside><div class="pcv2-stage"><img :src="img" alt="{{p.title|escape}}"></div></div>
<div class="pcv2-panel"><h1>{{p.title}}</h1>{% if section.settings.subtitle != blank %}<h2>{{section.settings.subtitle}}</h2>{% endif %}<div class="pcv2-price"><b x-text="money(price)"></b><span x-show="mode==='subscription'&&plan" x-text="' · '+plan.name"></span><span x-show="mode==='one-time'"> · Compra única</span></div>{% if section.settings.price_note != blank %}<p class="pcv2-note">{{section.settings.price_note}}</p>{% endif %}
<hr><div class="pcv2-label"><span>Compra</span><span>Suscripción</span></div><div class="pcv2-row"><button :class="mode==='subscription'?'sel':''" @click="mode=plans.length?'subscription':'one-time'">SUSCRIPCIÓN <span x-show="plans.length" x-text="money(price)"></span></button><button :class="mode==='one-time'?'sel':''" @click="mode='one-time'">COMPRA ÚNICA <span x-text="money(variant?.price||0)"></span></button></div>
<hr><div class="pcv2-label"><span>Frecuencia</span><span x-text="plan?plan.name:'Sin planes configurados'"></span></div><div class="pcv2-row" x-show="mode==='subscription'"><template x-for="pl in plans" :key="pl.id"><button :class="String(planId)===String(pl.id)?'sel':''" @click="planId=String(pl.id)" x-text="pl.name"></button></template><template x-if="!plans.length"><small>No subscription selling plans configured.</small></template></div>
{% for opt in p.options_with_values %}{% assign oi=forloop.index0 %}{% assign on=opt.name|downcase %}<hr><div class="pcv2-label"><span>{{opt.name}}</span></div><div class="pcv2-row">{% for val in opt.values %}{% if on contains 'color' %}<button class="pcv2-swatch" style="background:{{val|handle}}" :class="selected[{{oi}}]=== {{val|json|escape}}?'sel':''" :disabled="!available({{oi}},{{val|json|escape}})" @click="pick({{oi}},{{val|json|escape}})" title="{{val|escape}}"></button>{% else %}<button :class="selected[{{oi}}]=== {{val|json|escape}}?'sel':''" :disabled="!available({{oi}},{{val|json|escape}})" @click="pick({{oi}},{{val|json|escape}})">{{val}}</button>{% endif %}{% endfor %}</div>{% endfor %}
{% if section.settings.show_bottle %}<hr><div class="pcv2-label"><span>{{section.settings.bottle_heading}}</span><span>{{section.settings.bottle_caption}}</span></div><div class="pcv2-row"><span class="pcv2-bottle">{% if section.settings.bottle_img1 %}{{section.settings.bottle_img1|image_url:width:100|image_tag}}{% else %}＋{% endif %}</span><span class="pcv2-bottle">{% if section.settings.bottle_img2 %}{{section.settings.bottle_img2|image_url:width:100|image_tag}}{% else %}＋{% endif %}</span></div>{% endif %}
{% if section.settings.show_hydration %}<hr><label class="pcv2-hyd"><input type="checkbox"><span><b>{{section.settings.hydration_title}}</b><small>{{section.settings.hydration_copy}}</small><em>{{section.settings.regulatory}}</em></span></label>{% endif %}
<hr><div class="pcv2-total"><span>Total</span><b x-text="money(price)"></b></div><p class="pcv2-summary"><span x-show="mode==='subscription'">Suscripción · </span><span x-text="mode==='subscription'?(plan?.name||''):'Compra única'"></span>{% if section.settings.bottle_caption != blank %} · {{section.settings.bottle_caption}}{% endif %}</p>
{% form 'product',p %}<input type="hidden" name="id" :value="variant?.id||''"><input type="hidden" name="selling_plan" :value="mode==='subscription'&&plan?plan.id:''"><button class="pcv2-cart" type="submit" :disabled="!variant||!variant.available||(mode==='subscription'&&plans.length&&!plan)"><span>{{section.settings.cart_text}}</span><span>→</span></button>{% endform %}{% if section.settings.sample_text != blank %}<a class="pcv2-sample" href="{{section.settings.sample_url|default:'#'}}">{{section.settings.sample_text}}</a>{% endif %}</div></div></section>
<style>
#pcv2-{{uid}}{font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;background:{{section.settings.bg}};color:#171717;padding:{{section.settings.pad_y}}px {{section.settings.pad_x}}px}#pcv2-{{uid}} .pcv2-grid{max-width:{{section.settings.max_width}}px;margin:auto;display:grid;grid-template-columns:1fr .9fr;gap:clamp(24px,4vw,60px)}#pcv2-{{uid}} .pcv2-gallery{display:flex;gap:12px}#pcv2-{{uid}} .pcv2-thumbs{display:flex;flex-direction:column;gap:8px}#pcv2-{{uid}} .pcv2-thumbs button{width:64px;height:64px;border:1px solid transparent;background:white;padding:3px}#pcv2-{{uid}} .pcv2-thumbs button.active{border-color:#222}#pcv2-{{uid}} .pcv2-thumb-img{width:100%;height:100%;object-fit:contain}#pcv2-{{uid}} .pcv2-stage{position:relative;aspect-ratio:1;width:100%;background:{{section.settings.gallery_bg}}}#pcv2-{{uid}} .pcv2-stage img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}#pcv2-{{uid}} .pcv2-panel{max-width:560px}#pcv2-{{uid}} h1{font-size:clamp(28px,3vw,42px);font-weight:400;letter-spacing:-.035em;line-height:1.03;margin:0}#pcv2-{{uid}} h2{font-size:clamp(18px,2vw,25px);font-weight:400;margin:2px 0 8px}#pcv2-{{uid}} .pcv2-price{font-size:13px}#pcv2-{{uid}} .pcv2-price b{font-weight:400}#pcv2-{{uid}} .pcv2-note{font-size:10px;color:#555;margin:3px 0}#pcv2-{{uid}} hr{border:0;border-top:1px solid #ddd;margin:12px 0}#pcv2-{{uid}} .pcv2-label{display:flex;justify-content:space-between;gap:8px;font-size:10px;margin-bottom:6px}#pcv2-{{uid}} .pcv2-row{display:flex;flex-wrap:wrap;gap:6px}#pcv2-{{uid}} .pcv2-row button{font-size:9px;padding:5px 7px;border:1px solid #ddd;background:#f8f8f8;color:#555}#pcv2-{{uid}} .pcv2-row button.sel{border-color:#171717;background:white;color:#171717}#pcv2-{{uid}} button:disabled{opacity:.35}#pcv2-{{uid}} .pcv2-swatch{width:27px;height:27px;border-radius:50%;padding:0}#pcv2-{{uid}} .pcv2-bottle{width:34px;height:44px;border:1px solid #ddd;padding:2px;display:grid;place-items:center}#pcv2-{{uid}} .pcv2-bottle img{width:100%;height:100%;object-fit:contain}#pcv2-{{uid}} .pcv2-hyd{display:flex;gap:7px;font-size:9px}#pcv2-{{uid}} .pcv2-hyd input{margin:2px 0;accent-color:#f37021}#pcv2-{{uid}} .pcv2-hyd span{display:flex;flex-direction:column;gap:4px}#pcv2-{{uid}} .pcv2-hyd b{font-size:10px;font-weight:500}#pcv2-{{uid}} .pcv2-hyd small{line-height:1.35;color:#444}#pcv2-{{uid}} .pcv2-hyd em{font-size:8px;color:#f37021;font-style:normal}#pcv2-{{uid}} .pcv2-total{display:flex;justify-content:space-between;font-size:10px}#pcv2-{{uid}} .pcv2-total b{font-weight:500}#pcv2-{{uid}} .pcv2-summary{font-size:9px;color:#666;margin:4px 0 10px}#pcv2-{{uid}} .pcv2-cart{width:100%;display:flex;justify-content:space-between;padding:12px;background:#f37021;border:0;font-size:11px}#pcv2-{{uid}} .pcv2-cart:disabled{opacity:.4}#pcv2-{{uid}} .pcv2-sample{display:block;text-align:center;font-size:8px;color:#171717;text-decoration:none;margin-top:8px}@media(max-width:767px){#pcv2-{{uid}} .pcv2-grid{grid-template-columns:1fr;gap:24px}#pcv2-{{uid}} .pcv2-gallery{flex-direction:column-reverse}#pcv2-{{uid}} .pcv2-thumbs{flex-direction:row;overflow:auto}#pcv2-{{uid}} .pcv2-panel{max-width:none}}
</style>
{% endif %}
{% schema %}
{"name":"Product Configurator V2","tag":"section","class":"section-product-configurator-v2","enabled_on":{"templates":["product"]},"settings":[
{"type":"text","id":"subtitle","label":"Subtitle","default":"Electrolitos · 30 sobres"},{"type":"text","id":"price_note","label":"Price note","default":"1,10 € al día · Ahorras un 15 % · Sin permanencia"},{"type":"text","id":"cart_text","label":"Cart button","default":"Añadir al carrito"},{"type":"text","id":"sample_text","label":"Sample CTA","default":"PROBAR 5 SOBRES · 9 € →"},{"type":"url","id":"sample_url","label":"Sample URL"},{"type":"checkbox","id":"show_bottle","label":"Show bottle area","default":true},{"type":"text","id":"bottle_heading","label":"Bottle heading","default":"Botella de regalo"},{"type":"text","id":"bottle_caption","label":"Bottle caption","default":"SixSixty 660 ml"},{"type":"image_picker","id":"bottle_img1","label":"Bottle image 1"},{"type":"image_picker","id":"bottle_img2","label":"Bottle image 2"},{"type":"checkbox","id":"show_hydration","label":"Show hydration text","default":true},{"type":"text","id":"hydration_title","label":"Hydration title","default":"Recovery Hydration · 250 mg de vitamina C por sobre"},{"type":"textarea","id":"hydration_copy","label":"Hydration description","default":"La vitamina C contribuye a mantener el funcionamiento normal del sistema inmunitario durante el ejercicio físico intenso y después de este."},{"type":"text","id":"regulatory","label":"Regulatory note","default":"Pendiente de validación del asesor regulatorio"},{"type":"color","id":"bg","label":"Section background","default":"#f5f5f5"},{"type":"color","id":"gallery_bg","label":"Gallery background","default":"#f5f5f5"},{"type":"range","id":"max_width","label":"Max width","min":900,"max":1600,"step":50,"default":1300,"unit":"px"},{"type":"range","id":"pad_y","label":"Vertical padding","min":0,"max":100,"step":4,"default":48,"unit":"px"},{"type":"range","id":"pad_x","label":"Horizontal padding","min":0,"max":80,"step":4,"default":24,"unit":"px"}],"presets":[{"name":"Product Configurator V2"}]}
{% endschema %}
