{%- liquid
  assign p = product
  assign uid = section.id
  assign cv = p.selected_or_first_available_variant
-%}
{%- if p == blank -%}
  <section class="p-8 text-center">Product not found.</section>
{%- else -%}
{%- capture variants_json -%}
[{%- for v in p.variants -%}
{"id":{{ v.id }},"price":{{ v.price }},"available":{{ v.available | json }},"options":{{ v.options | json }},"image":{% if v.featured_image %}{{ v.featured_image | image_url: width: 1400 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}]
{%- endcapture -%}
{%- capture colors_json -%}
{ {%- assign lines = section.settings.color_map | newline_to_br | split: '<br />' -%}{%- assign first = true -%}
{%- for line in lines -%}{%- assign parts = line | strip | split: '|' -%}{%- if parts.size >= 2 -%}{% unless first %},{% endunless %}{%- assign first = false -%}{{ parts[0] | strip | downcase | json }}:{"name":{{ parts[1] | strip | json }},"hex":{{ parts[2] | default: '' | strip | json }}}{%- endif -%}{%- endfor -%} }
{%- endcapture -%}

<section
  id="vc-{{ uid }}"
  class="vc"
  x-data='{
    variants: {{ variants_json | strip_newlines | escape }},
    colors: {{ colors_json | strip_newlines | escape }},
    selected: {{ cv.options | json | escape }},
    currency: {{ cart.currency.iso_code | json | escape }},
    img: {% if cv.featured_image %}{{ cv.featured_image | image_url: width: 1400 | json | escape }}{% elsif p.featured_media %}{{ p.featured_media | image_url: width: 1400 | json | escape }}{% else %}""{% endif %},
    busy: false,
    error: "",
    get variant() {
      return this.variants.find(v => v.options.every((o, i) => o === this.selected[i])) || null;
    },
    money(c) { return new Intl.NumberFormat("es-ES", { style: "currency", currency: this.currency }).format(Number(c || 0) / 100); },
    colorName(v) { const c = this.colors[String(v).toLowerCase()]; return c && c.name ? c.name : v; },
    pick(i, value) {
      const s = this.selected.slice(); s[i] = value; this.selected = s;
      if (this.variant && this.variant.image) this.img = this.variant.image;
    },
    async add() {
      const v = this.variant;
      if (!v || !v.available || this.busy) return;
      this.busy = true; this.error = "";
      try {
        const r = await fetch("/cart/add.js", { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify({ id: v.id, quantity: 1 }) });
        const j = await r.json();
        if (!r.ok) throw new Error(j.description || j.message || "Error");
        window.dispatchEvent(new CustomEvent("cart:refresh"));
      } catch (e) { this.error = e.message; }
      this.busy = false;
    }
  }'
>
  <div class="vc__grid">
    <div class="vc__gallery">
      {%- if p.media.size > 1 -%}
        <div class="vc__thumbs">
          {%- for m in p.media -%}
            {%- if m.media_type == 'image' -%}
              <button
                type="button"
                class="vc__thumb"
                :class="img === {{ m | image_url: width: 1400 | json | escape }} ? 'is-active' : ''"
                @click="img = {{ m | image_url: width: 1400 | json | escape }}"
                aria-label="{{ m.alt | default: p.title | escape }}"
              >
                {{ m | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="vc__stage">
        {%- if p.featured_media -%}
          <img :src="img" src="{{ p.featured_media | image_url: width: 1400 }}" alt="{{ p.title | escape }}" width="1400" height="{{ 1400 | divided_by: p.featured_media.aspect_ratio | round }}">
        {%- endif -%}
      </div>
    </div>

    <div class="vc__panel">
      <h1 class="vc__title">{{ p.title }}</h1>
      <p class="vc__price" x-text="money(variant ? variant.price : {{ cv.price }})">{{ cv.price | money }}</p>
      {%- if section.settings.shipping_text != blank -%}<p class="vc__note">{{ section.settings.shipping_text }}</p>{%- endif -%}

      {%- if p.description != blank -%}
        <div class="vc__block vc__block--first">
          <p class="vc__label">{{ section.settings.description_heading }}</p>
          <div class="vc__desc">{{ p.description }}</div>
        </div>
      {%- endif -%}

      <div class="vc__block vc__block--last{% if p.description == blank %} vc__block--first{% endif %}">
        {%- unless p.has_only_default_variant -%}
          {%- for opt in p.options_with_values -%}
            {%- assign oi = forloop.index0 -%}
            {%- assign oname = opt.name | downcase -%}
            <div class="vc__option">
              <p class="vc__label vc__label--row"><span>{{ opt.name }}</span><span x-text="colorName(selected[{{ oi }}])">{{ opt.selected_value }}</span></p>
              <div class="vc__row">
                {%- for val in opt.values -%}
                  {%- if oname contains 'color' or oname contains 'colour' -%}
                    <button
                      type="button"
                      class="vc__swatch"
                      :class="{ 'is-selected': selected[{{ oi }}] === {{ val | json | escape }} }"
                      :style="'--sw:' + ((colors[{{ val | downcase | json | escape }}] || {}).hex || {{ val | handle | json | escape }})"
                      @click="pick({{ oi }}, {{ val | json | escape }})"
                      :aria-label="colorName({{ val | json | escape }})"
                      :title="colorName({{ val | json | escape }})"
                    ></button>
                  {%- else -%}
                    <button
                      type="button"
                      class="vc__opt"
                      :class="{ 'is-selected': selected[{{ oi }}] === {{ val | json | escape }} }"
                      @click="pick({{ oi }}, {{ val | json | escape }})"
                    >{{ val }}</button>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <button type="button" class="vc__cart" :disabled="busy || !variant || !variant.available" @click="add()">
          <span x-text="variant && variant.available ? {{ section.settings.button_text | json | escape }} : {{ section.settings.soldout_text | json | escape }}">{{ section.settings.button_text }}</span>
          <svg class="vc__ico" width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true"><path d="M0 6h14M9 1l5 5-5 5" stroke="currentColor" stroke-width="1.4"/></svg>
        </button>
        <p class="vc__error" x-show="error" x-text="error" x-cloak></p>
        {%- if section.settings.bottom_text != blank -%}<p class="vc__bottom">{{ section.settings.bottom_text }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  {%- comment -%} Sizes in vw: mobile based on a 375px viewport, desktop (>=990px) on a 1440px viewport. {%- endcomment -%}
  #vc-{{ uid }} { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; background: {{ section.settings.background_color }}; color: #171717; padding: 6.4vw 4.267vw 10.667vw; }
  #vc-{{ uid }} [x-cloak] { display: none !important; }
  #vc-{{ uid }} p { margin: 0; }
  #vc-{{ uid }} button { font-family: inherit; cursor: pointer; }
  #vc-{{ uid }} .vc__grid { margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 6.4vw; align-items: start; }
  #vc-{{ uid }} .vc__gallery { display: flex; flex-direction: column-reverse; align-items: center; gap: 3.2vw; }
  #vc-{{ uid }} .vc__thumbs { display: flex; flex-direction: row; overflow-x: auto; max-width: 100%; scrollbar-width: none; }
  #vc-{{ uid }} .vc__thumbs::-webkit-scrollbar { display: none; }
  #vc-{{ uid }} .vc__thumb { flex: 0 0 auto; width: 16.533vw; height: 15.2vw; padding: 0; border: 0; background: transparent; opacity: 1; }
  
  #vc-{{ uid }} .vc__thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }
  #vc-{{ uid }} .vc__stage { width: 100%; height: 100vw; display: flex; align-items: center; justify-content: center; }
  #vc-{{ uid }} .vc__stage img { max-width: 100%; max-height: 90%; width: auto; height: auto; object-fit: contain; }
  #vc-{{ uid }} .vc__title { font-size: 7.467vw; line-height: 1.1; font-weight: 400; letter-spacing: -0.01em; margin: 0 0 2.667vw; }
  #vc-{{ uid }} .vc__price { font-size: 4vw; color: #555; margin-bottom: 1.067vw; }
  #vc-{{ uid }} .vc__note { font-size: 3.2vw; color: #555; line-height: 1.4; }
  #vc-{{ uid }} .vc__block { border-top: 1px solid #dcdcdc; padding: 4.267vw 0 4.8vw; }
  #vc-{{ uid }} .vc__block--first { margin-top: 6.4vw; }
  #vc-{{ uid }} .vc__label { font-size: 3.467vw; margin-bottom: 4.267vw; }
  #vc-{{ uid }} .vc__label--row { display: flex; gap: 2.667vw; margin-bottom: 2.667vw; }
  #vc-{{ uid }} .vc__desc { font-size: 3.467vw; line-height: 1.3; }
  #vc-{{ uid }} .vc__desc p { margin: 0; }
  #vc-{{ uid }} .vc__desc p:empty { display: none; }
  #vc-{{ uid }} .vc__option + .vc__option { margin-top: 4.267vw; }
  #vc-{{ uid }} .vc__row { display: flex; flex-wrap: wrap; align-items: center; gap: 2.667vw; }
  #vc-{{ uid }} .vc__swatch { width: 5.867vw; height: 5.867vw; padding: 0.533vw; border: 1px solid #cfcfcf; border-radius: 2px; background: var(--sw) content-box; }
  #vc-{{ uid }} .vc__swatch.is-selected { border-color: #171717; }
  #vc-{{ uid }} .vc__opt { font-size: 2.667vw; text-transform: uppercase; letter-spacing: .04em; padding: 1.333vw 1.067vw; border: 1px solid #e2e2e2; background: transparent; color: #8a8a8a; }
  #vc-{{ uid }} .vc__opt.is-selected { border-color: #171717; color: #171717; }
  #vc-{{ uid }} .vc__block--last { border-top: 1px solid #dcdcdc; }
  #vc-{{ uid }} .vc__cart { margin-top: 8.533vw; display: inline-flex; align-items: center; gap: 4.267vw; background: #f37021; color: #171717; border: 0; padding: 2.667vw 3.2vw; font-size: 3.733vw; }
  #vc-{{ uid }} .vc__cart:disabled { opacity: .5; cursor: not-allowed; }
  #vc-{{ uid }} .vc__ico { width: 4.267vw; height: 3.2vw; }
  #vc-{{ uid }} .vc__error { font-size: 3.2vw; color: #c0392b; margin-top: 2.667vw; }
  #vc-{{ uid }} .vc__bottom { font-size: 2.667vw; line-height: 1.5; color: #8a8a8a; margin-top: 8vw; }
  @media (min-width: 990px) {
    #vc-{{ uid }} { padding: {{ section.settings.pad_y | divided_by: 14.4 | round: 3 }}vw 5.556vw {{ section.settings.pad_y | divided_by: 14.4 | round: 3 }}vw 0.556vw; }
    #vc-{{ uid }} .vc__grid { grid-template-columns: minmax(0, 1fr) 28.889vw; gap: 4.444vw; }
    #vc-{{ uid }} .vc__gallery { flex-direction: row; align-items: stretch; gap: 1.667vw; height: 55.556vw; position: sticky; top: 2.778vw; }
    #vc-{{ uid }} .vc__thumbs { flex-direction: column; justify-content: flex-end; flex: 0 0 4.306vw; overflow: visible; padding-bottom: 5.694vw; }
    #vc-{{ uid }} .vc__thumb { width: 4.306vw; height: 3.958vw; }
    #vc-{{ uid }} .vc__stage { flex: 1; width: auto; height: auto; }
    #vc-{{ uid }} .vc__stage img { max-height: 39.861vw; }
    #vc-{{ uid }} .vc__panel { padding-top: 5.556vw; }
    #vc-{{ uid }} .vc__title { font-size: 2.222vw; margin-bottom: 0.694vw; }
    #vc-{{ uid }} .vc__price { font-size: 1.042vw; margin-bottom: 0.208vw; }
    #vc-{{ uid }} .vc__note { font-size: 0.833vw; }
    #vc-{{ uid }} .vc__block { padding: 1.111vw 0 1.111vw; }
    #vc-{{ uid }} .vc__block--first { margin-top: 1.667vw; }
    #vc-{{ uid }} .vc__label { font-size: 0.903vw; margin-bottom: 1.528vw; }
    #vc-{{ uid }} .vc__label--row { gap: 0.694vw; margin-bottom: 0.694vw; }
    #vc-{{ uid }} .vc__desc { font-size: 0.903vw; }
    #vc-{{ uid }} .vc__option + .vc__option { margin-top: 1.111vw; }
    #vc-{{ uid }} .vc__row { gap: 0.694vw; }
    #vc-{{ uid }} .vc__swatch { width: 1.667vw; height: 1.667vw; padding: 0.139vw; }
    #vc-{{ uid }} .vc__opt { font-size: 0.694vw; padding: 0.347vw 0.278vw; }
    #vc-{{ uid }} .vc__cart { margin-top: 2.222vw; gap: 1.111vw; padding: 0.694vw 0.833vw; font-size: 0.972vw; }
    #vc-{{ uid }} .vc__ico { width: 1.111vw; height: 0.833vw; }
    #vc-{{ uid }} .vc__error { font-size: 0.833vw; margin-top: 0.694vw; }
    #vc-{{ uid }} .vc__bottom { font-size: 0.694vw; margin-top: 2.639vw; }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Vaso configurator",
  "tag": "section",
  "class": "section-vaso-configurator",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "shipping_text", "label": "Text under price", "default": "IVA incluido. Envío 5,90 € en península, gratis si añades un doypack." },
    { "type": "text", "id": "description_heading", "label": "Description heading", "default": "Descripción" },
    { "type": "textarea", "id": "color_map", "label": "Color names and swatches", "info": "One per line: variant value|display name|hex color", "default": "Orange|Naranja|#f37021\nWhite|Blanco|#ffffff\nBlack|Negro|#2b2b2b" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Añadir al carrito" },
    { "type": "text", "id": "soldout_text", "label": "Sold out text", "default": "Agotado" },
    { "type": "textarea", "id": "bottom_text", "label": "Text below button", "default": "Prestaciones (frío/calor, antigoteo, sin BPA): solo se publican con el certificado del proveedor" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f4f4f4" },
    { "type": "range", "id": "pad_y", "label": "Vertical padding (px at 1440 viewport)", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" }
  ],
  "presets": [{ "name": "Vaso configurator" }]
}
{% endschema %}
