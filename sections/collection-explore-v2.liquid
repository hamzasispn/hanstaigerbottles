
<section id="collection-explore-v2-{{ section.id }}" class="collection-explore-v2">
  <div class="collection-explore-v2-inner">

    {% if section.settings.heading != blank %}
      <h2 class="collection-explore-v2-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="collection-explore-v2-count">
      {{ section.settings.collection_label }}
      {% if section.settings.collection != blank %}
        ({{ section.settings.collection.products_count }})
      {% endif %}
    </div>

    {% if section.settings.collection != blank %}
      <div class="collection-explore-v2-grid">

        {% for product in section.settings.collection.products limit: 4 %}

          <div class="collection-explore-v2-card">

            <a href="{{ product.url }}" class="collection-explore-v2-image-link">
              <div class="collection-explore-v2-image">

                {% if product.featured_image %}
                  {{
                    product.featured_image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      class: 'collection-explore-v2-product-image',
                      alt: product.title
                  }}
                {% endif %}

              </div>
            </a>

            <div class="collection-explore-v2-product-info">

              <a href="{{ product.url }}" class="collection-explore-v2-product-title">
                {{ product.title }}
                {% if product.selected_or_first_available_variant.title != 'Default Title' %}
                  - {{ product.selected_or_first_available_variant.title }}
                {% endif %}
                · {{ product.price | money }}
              </a>

              <div class="collection-explore-v2-actions">

                {% if product.available %}
                  <form method="post" action="/cart/add" class="collection-explore-v2-cart-form">
                    <input
                      type="hidden"
                      name="id"
                      value="{{ product.selected_or_first_available_variant.id }}"
                    >

                    <button type="submit" class="collection-explore-v2-add-button">
                      {{ section.settings.add_to_cart_text }}
                    </button>
                  </form>
                {% else %}
                  <span class="collection-explore-v2-sold-out">
                    Sold out
                  </span>
                {% endif %}

                {% assign color_option = nil %}

                {% for option in product.options_with_values %}
                  {% assign option_name = option.name | downcase %}

                  {% if option_name == 'color' or option_name == 'colour' or option_name == 'colores' %}
                    {% assign color_option = option %}
                  {% endif %}
                {% endfor %}

                {% if color_option %}
                  <div class="collection-explore-v2-swatches">

                    {% for color in color_option.values limit: 4 %}

                      {% assign color_downcase = color | downcase %}

                      <span
                        class="collection-explore-v2-swatch"
                        title="{{ color }}"
                        style="--swatch-color: {{ color_downcase }};"
                      ></span>

                    {% endfor %}

                  </div>
                {% endif %}

              </div>

            </div>

          </div>

        {% endfor %}

      </div>
    {% else %}
      <div class="collection-explore-v2-empty">
        Select a collection in the section settings.
      </div>
    {% endif %}

  </div>
</section>


<style>

  #collection-explore-v2-{{ section.id }} {
    padding-top: 5vw;
    padding-bottom: 5vw;
  }

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-inner {
    width: 88.889vw;
    max-width: 88.889vw;
    margin: 0 auto;
  }


  /* HEADING */

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-heading {
    margin: 0 0 2.778vw;
    font-size: 1.944vw;
    font-weight: 400;
    line-height: 1.15;
    color: #111111;
  }


  /* COLLECTION COUNT */

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-count {
    margin-bottom: 1.667vw;
    font-size: 0.694vw;
    font-weight: 400;
    line-height: 1.2;
    color: #111111;
  }


  /* GRID */

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.111vw;
    row-gap: 2.5vw;
  }


  /* PRODUCT CARD */

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-card {
    min-width: 0;
  }


  /* IMAGE */

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-image-link {
    display: block;
    text-decoration: none;
  }

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-image {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-product-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 0.4s ease;
  }

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-card:hover .collection-explore-v2-product-image {
    transform: scale(1.03);
  }


  /* PRODUCT INFO */

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-product-info {
    padding-top: 0.694vw;
  }

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-product-title {
    display: block;
    margin-bottom: 0.694vw;
    font-size: 0.625vw;
    font-weight: 400;
    line-height: 1.4;
    color: #777777;
    text-transform: uppercase;
    text-decoration: none;
  }


  /* ACTIONS */

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-actions {
    display: flex;
    align-items: center;
    gap: 0.556vw;
    flex-wrap: wrap;
  }

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-cart-form {
    margin: 0;
  }

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-add-button {
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    color: #111111;
    font-family: inherit;
    font-size: 0.625vw;
    font-weight: 400;
    line-height: 1.2;
    text-transform: uppercase;
    cursor: pointer;
  }

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-add-button:hover {
    opacity: 0.6;
  }


  /* SWATCHES */

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-swatches {
    display: flex;
    align-items: center;
    gap: 0.417vw;
  }

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-swatch {
    display: block;
    width: 0.833vw;
    height: 0.833vw;
    min-width: 0.833vw;
    border: 0.069vw solid rgba(0, 0, 0, 0.12);
    border-radius: 0.139vw;
    background: var(--swatch-color);
  }


  /* SOLD OUT */

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-sold-out {
    font-size: 0.625vw;
    text-transform: uppercase;
    color: #777777;
  }


  /* EMPTY */

  #collection-explore-v2-{{ section.id }} .collection-explore-v2-empty {
    padding: 3vw 0;
    font-size: 1vw;
  }


  /* MOBILE */

  @media (max-width: 767px) {

    #collection-explore-v2-{{ section.id }} {
      padding-top: 10vw;
      padding-bottom: 10vw;
    }

    #collection-explore-v2-{{ section.id }} .collection-explore-v2-inner {
      width: 92vw;
      max-width: 92vw;
    }

    #collection-explore-v2-{{ section.id }} .collection-explore-v2-heading {
      margin-bottom: 5vw;
      font-size: 6vw;
    }

    #collection-explore-v2-{{ section.id }} .collection-explore-v2-count {
      margin-bottom: 4vw;
      font-size: 3vw;
    }

    #collection-explore-v2-{{ section.id }} .collection-explore-v2-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5vw;
      row-gap: 7vw;
    }

    #collection-explore-v2-{{ section.id }} .collection-explore-v2-product-info {
      padding-top: 2vw;
    }

    #collection-explore-v2-{{ section.id }} .collection-explore-v2-product-title {
      margin-bottom: 2vw;
      font-size: 2.4vw;
      line-height: 1.4;
    }

    #collection-explore-v2-{{ section.id }} .collection-explore-v2-actions {
      gap: 1.5vw;
    }

    #collection-explore-v2-{{ section.id }} .collection-explore-v2-add-button {
      font-size: 2.4vw;
    }

    #collection-explore-v2-{{ section.id }} .collection-explore-v2-swatches {
      gap: 1vw;
    }

    #collection-explore-v2-{{ section.id }} .collection-explore-v2-swatch {
      width: 2.5vw;
      height: 2.5vw;
      min-width: 2.5vw;
      border-radius: 0.4vw;
    }

    #collection-explore-v2-{{ section.id }} .collection-explore-v2-sold-out {
      font-size: 2.4vw;
    }

  }

</style>


{% schema %}
{
  "name": "Collection Explore V2",
  "tag": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Los cuatro modelos"
    },
    {
      "type": "text",
      "id": "collection_label",
      "label": "Collection Label",
      "default": "Todos"
    },
    {
      "type": "text",
      "id": "add_to_cart_text",
      "label": "Add to Cart Text",
      "default": "Añadir al carrito"
    }
  ],
  "presets": [
    {
      "name": "Collection Explore V2"
    }
  ]
}
{% endschema %}
